TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3455/callback/

# Leave false for the real TikTok API. Set true only for local demo data.
MOCK_TIKTOK=false

# Optional: stable session signing key for the local Flask app.
FLASK_SECRET_KEY=

# Optional local preferences.
APP_TIMEZONE=America/Campo_Grande
# TIKTOK_DATABASE_PATH=database/relatorio_tiktok.db
# TIKTOK_EXPORTS_DIR=exports

# Optional local AI. Keep false until ./setup_ai.sh has completed.
AI_ENABLED=false
AI_DEVICE=cuda

AI_WHISPER_MODEL=large-v3-turbo
AI_WHISPER_COMPUTE_TYPE=float16

AI_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
AI_VISION_DTYPE=bfloat16

AI_TEMP_DIR=tmp/tiktok_ai
AI_DELETE_TEMP_FILES=true

AI_MAX_FRAMES=12
AI_MAX_IMAGE_SIDE=896

# Optional: let yt-dlp read the browser profile directly; never copied or logged.
AI_DOWNLOAD_COOKIES_BROWSER=

AI_AUTO_ANALYZE_NEW_VIDEOS=false
